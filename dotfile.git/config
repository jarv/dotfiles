[push]
    default = current
    autoSetupRemote = true
[core]
    excludesfile = ~/.cvsignore
    editor = nvim
[user]
    name = John Jarvis
    email = john@jarv.org
    signingkey = ~/.ssh/id_ed25519_sk_github
[url "git@gitlab.com:"]
    insteadOf = https://gitlab.com/
[url "git@github.com:"]
    insteadOf = https://github.com/
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[alias]
    change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f "
    find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 -s | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
    show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"
    merge-log = "!f() { git log --stat \"$1^..$1\"; }; f"
    pushf = push --force-with-lease
    checkout-bydate = "!f() { git checkout $(git rev-list -n 1 --first-parent --before=\"$1\" master); }; f"
    recent = branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\"
    default-branch = "!git symbolic-ref refs/remotes/origin/HEAD --short | sed 's|origin/||'"
    update-default-branch = remote set-head origin --auto

[merge]
    ff = false
[pull]
    ff = only
	rebase = true
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = ~/.local/bin/ssh-keygen-yubikey
[init]
    defaultBranch = main
[maintenance]
	repo = ~/workspace/gdk
	repo = ~/workspace/gdk/gitlab
	repo = /Users/jarv/workspace/gdk
	repo = /Users/jarv/workspace/gdk/gitlab
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = identity.gitlab.gitconfig
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
    path = identity.gitlab.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.com/**"]
    path = identity.gitlab.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = signing.github.local.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = signing.github.local.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
    path = signing.github.local.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:supabase/**"]
    path = identity.supabase.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/supabase/**"]
    path = identity.supabase.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/supabase/**"]
    path = identity.supabase.gitconfig
[include]
    path = machine.local.gitconfig
