{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/workspace/**": "allow",
      "~/supabase/**": "allow",
      "~/.config/**": "allow",
      "~/src/**": "allow",
      "~/.local/share/mise/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "/private/var/tmp/**": "allow",
      "/var/folders/**": "allow",
      "/private/var/folders/**": "allow",
      "~/gitlab/**": "allow",
      "~/.agents/skills/**": "allow"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.netrc": "deny"
    }
  },
  "provider": {
    "homer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "homer (Ollama)",
      "options": {
        "baseURL": "http://homer:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B-A3B",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--headless",
        "--browser",
        "chromium",
        "--executable-path",
        "/home/jarv/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome"
      ]
    }
  }
}
