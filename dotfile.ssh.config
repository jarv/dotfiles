# ~/.ssh/config  (ln -sf ~/src/jarv/dotfiles/dotfile.ssh.config ~/.ssh/config)

# macOS only: use the YubiKey PIV slot directly through the system PKCS11
# provider with the system /usr/bin/ssh. No yubikey-agent, no brew openssh.
# Load into the agent once per boot:  ssh-add -s /usr/lib/ssh-keychain.dylib
Match exec "test -e /usr/lib/ssh-keychain.dylib"
  PKCS11Provider /usr/lib/ssh-keychain.dylib

Host llmbox
  HostName llmbox
  User jarv
  ForwardAgent no

Host *
  AddKeysToAgent yes
  ServerAliveInterval 30
