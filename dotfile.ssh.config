# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# ~/.ssh/config  (ln -sf ~/src/jarv/dotfiles/dotfile.ssh.config ~/.ssh/config)

# Machine-specific SSH settings take precedence over the shared defaults below.
Include ~/.config/ssh/config.local

Host homer
  HostName homer
  User jarv
  ForwardAgent no

Host *
  AddKeysToAgent yes
  ServerAliveInterval 30
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist 10m

Host github.com
  Hostname github.com
  User git
