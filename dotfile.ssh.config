# ~/.ssh/config  (ln -sf ~/src/jarv/dotfiles/dotfile.ssh.config ~/.ssh/config)

# Machine-specific SSH settings take precedence over the shared defaults below.
Include ~/.config/ssh/config.local

Host homer
  HostName homer
  User jarv
  ForwardAgent no

Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519_sk_github
  IdentitiesOnly yes
  ServerAliveInterval 30
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist 10m

Host github.com
  Hostname github.com
  User git
  IdentityAgent none
