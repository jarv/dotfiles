# Workstation (dev laptop). Server/homer uses setup/macos.server/Brewfile.
#   brew bundle --file ~/src/jarv/dotfiles/setup/macos.workstation/Brewfile
#
# Only things that need brew live here: daemons/system integration, GNU
# userland, libraries-heavy tools, casks and fonts. Single-binary CLIs and
# toolchains are in dotfile.mise/config.toml (shared with Linux).
#
# No brew openssh: the system ssh is used everywhere.
tap "homebrew/services"
tap "context-labs/mactop"
tap "starkandwayne/cf"
tap "universal-ctags/universal-ctags"

# shell / GNU userland (dotfile.zshrc puts gnubin on PATH)
